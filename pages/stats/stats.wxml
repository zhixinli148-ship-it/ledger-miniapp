<view class="page-bg">
  <view class="wash"></view>
</view>

<!-- 自定义导航：置顶为大标题，滚动后玻璃底淡入、标题收拢 -->
<view
  class="nav {{navScrolled ? 'is-scrolled' : ''}} {{reduceMotion ? 'reduce-motion' : ''}}"
  style="padding-top: {{statusBarHeight + 14}}px;"
>
  <view class="nav-bg"></view>
  <text class="nav-title">统计</text>
</view>

<!-- 内容整块挂在 runs 的 key 上。
 * 小程序里节点复用后 CSS 入场动画不会自己重播，
 * 每次切回本页时换一个 key，让这块重建，动画就会从头播一遍。 -->
<block wx:for="{{runs}}" wx:key="*this">
<view class="container {{reduceMotion ? 'reduce-motion' : ''}}" style="padding-top: {{navHeight}}px;">

  <!-- 月份 + 类型 -->
  <view class="filter-row anim-fade">
    <view class="glass month-pill">
      <picker mode="date" fields="month" value="{{month}}" bindchange="onMonthChange">
        <view class="month-value">{{monthLabel}} ▾</view>
      </picker>
    </view>

    <view class="glass type-pill">
      <view
        class="tp-item {{type === 'expense' ? 'tp-active' : ''}}"
        data-type="expense"
        bindtap="switchType"
      >支出</view>
      <view
        class="tp-item {{type === 'income' ? 'tp-active' : ''}}"
        data-type="income"
        bindtap="switchType"
      >收入</view>
    </view>
  </view>

  <!-- 总额 -->
  <view class="glass glass-sheen total-card anim-up" style="animation-delay: 40ms;">
    <view class="total-label t3">{{monthLabel}} {{type === 'expense' ? '总支出' : '总收入'}}</view>
    <view class="total-value amount {{type === 'expense' ? 'expense' : 'income'}}">
      ¥ {{totalText}}
    </view>
    <view class="total-sub t3">共 {{count}} 笔 · 日均 ¥{{dailyAvg}}</view>
  </view>

  <!-- 分类占比 -->
  <block wx:if="{{groups.length}}">
    <view class="section-title">分类占比</view>

    <view class="glass rank-card">
      <view
        wx:for="{{groups}}"
        wx:key="categoryId"
        class="rank-item anim-up"
        style="animation-delay: {{item.delay}}ms;"
      >
        <view class="rank-head">
          <view class="rank-left">
            <text class="rank-emoji">{{item.emoji}}</text>
            <text class="rank-name">{{item.name}}</text>
          </view>
          <view class="rank-right">
            <text class="rank-amount amount">¥{{item.valueText}}</text>
            <text class="rank-pct t3">{{item.percent}}%</text>
          </view>
        </view>
        <view class="bar-track">
          <view
            class="bar-fill {{type === 'expense' ? 'bar-expense' : 'bar-income'}}"
            style="transform: scaleX({{item.scale}});"
          ></view>
        </view>
      </view>
    </view>
  </block>

  <!-- 空状态 -->
  <view class="glass empty anim-up" style="animation-delay: 80ms;" wx:else>
    <view class="empty-icon">📊</view>
    <view class="empty-title">本月没有{{type === 'expense' ? '支出' : '收入'}}记录</view>
    <view class="empty-desc">换个类型或月份，也可以记一笔</view>
    <view class="empty-action" bindtap="goAdd">去记一笔</view>
  </view>

  <view class="bottom-space"></view>
</view>
</block>
