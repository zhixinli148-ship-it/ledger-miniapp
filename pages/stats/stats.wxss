/* 统计 */

/* ---- 筛选行 ---- */
.filter-row {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.month-pill {
  padding: 20rpx 32rpx;
  border-radius: var(--r-md);
}

.month-value {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-1);
}

.type-pill {
  display: flex;
  padding: 6rpx;
  border-radius: var(--r-md);
  margin-left: auto;
}

.tp-item {
  padding: 14rpx 30rpx;
  font-size: 26rpx;
  color: var(--text-3);
  border-radius: var(--r-sm);
  transition: color var(--dur-fast) ease-out, background-color var(--dur-fast) ease-out;
}

.tp-active {
  color: #fff;
  background: var(--accent);
}

/* ---- 总额卡 ---- */
.total-card {
  margin-top: 24rpx;
  padding: 44rpx 40rpx 40rpx;
}

.total-label {
  font-size: 24rpx;
}

.total-value {
  font-size: 68rpx;
  font-weight: 600;
  margin: 10rpx 0 14rpx;
}

.total-sub {
  font-size: 22rpx;
}

/* ---- 分类排行 ---- */
.section-title {
  margin: 44rpx 8rpx 20rpx;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text-1);
}

.rank-card {
  padding: 20rpx 32rpx 14rpx;
}

.rank-item {
  padding: 22rpx 0;
}

.rank-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.rank-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.rank-emoji {
  font-size: 32rpx;
}

.rank-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-1);
}

.rank-right {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  flex-shrink: 0;
}

.rank-amount {
  font-size: 28rpx;
  color: var(--text-1);
}

.rank-pct {
  font-size: 22rpx;
  min-width: 72rpx;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

/* ---- 进度条：用 scaleX 而非 width，走合成层 ---- */
.bar-track {
  height: 12rpx;
  border-radius: 12rpx;
  background: rgba(20, 23, 31, 0.06);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  width: 100%;
  border-radius: 12rpx;
  transform-origin: left center;
  transform: scaleX(0);
  transition: transform 420ms ease-out;
}

.bar-expense {
  background: var(--expense);
}

.bar-income {
  background: var(--income);
}
