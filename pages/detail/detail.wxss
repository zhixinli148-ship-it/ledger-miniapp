/* 详情 */

.nav-back {
  position: absolute;
  left: 24rpx;
  bottom: 14rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform var(--dur-press) ease-out;
}

.nav-back:active {
  transform: scale(0.9);
}

/* 用 CSS 画返回箭头，避免字体符号在不同设备上不一致 */
.back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 3rpx solid var(--text-1);
  border-bottom: 3rpx solid var(--text-1);
  transform: rotate(45deg);
  margin-left: 6rpx;
}

/* ---- 金额头卡 ---- */
.head-card {
  margin-top: 24rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.head-emoji {
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--r-lg);
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid var(--glass-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  margin-bottom: 24rpx;
}

.head-amount {
  font-size: 62rpx;
  font-weight: 600;
}

.head-cat {
  font-size: 26rpx;
  margin-top: 10rpx;
}

/* ---- 信息卡 ---- */
.info-card {
  margin-top: 24rpx;
  padding: 6rpx 32rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  position: relative;
}

.info-row::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: var(--hairline);
}

.info-row:last-child::after {
  display: none;
}

.info-k {
  font-size: 26rpx;
}

.info-v {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-1);
  max-width: 62%;
  text-align: right;
  word-break: break-all;
}

/* ---- 删除 ---- */
.delete-btn {
  margin-top: 44rpx;
  height: 96rpx;
  border-radius: var(--r-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--expense);
  background: var(--danger-soft);
  border: 1rpx solid rgba(239, 68, 68, 0.24);
  transition: transform var(--dur-press) ease-out, background-color var(--dur-press) ease-out;
}

.delete-btn:active {
  transform: scale(0.98);
  background: rgba(239, 68, 68, 0.16);
}
